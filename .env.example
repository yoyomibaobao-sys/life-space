CRON_SECRET=

# Public browser configuration. Supabase publishable keys are intentionally
# safe for client bundles; never place a secret/service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only key used by trusted payment and maintenance routes. Never expose
# this value through NEXT_PUBLIC_* or include a real key in source control.
SUPABASE_SERVICE_ROLE_KEY=

# Optional public overrides. The checked-in ¥64 Alipay business poster and
# payee name are used by default. Do not place passwords or private keys here.
NEXT_PUBLIC_ALIPAY_PAYMENT_QR_URL=
NEXT_PUBLIC_ALIPAY_PAYEE_NAME=

# PayPal REST credentials are server-only. Never prefix the secret with
# NEXT_PUBLIC_ and never commit a real Client ID/Secret to this file.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Keep the public checkout disabled until Sandbox verification is complete and
# the matching server-only credentials/webhook are configured in this deploy.
NEXT_PUBLIC_PAYPAL_ENABLED=false
# Server-runtime alias preferred for Cloudflare Workers feature gating.
PAYPAL_ENABLED=false

# Exact public origin that PayPal returns to, without a trailing path. Use the
# canary origin for Sandbox testing and https://life-space.uk for production.
PAYPAL_SITE_ORIGIN=

# Set this after the deployed Sandbox webhook has been created in PayPal.
# The webhook endpoint is /api/paypal/webhook.
PAYPAL_WEBHOOK_ID=