CRON_SECRET=

# Public browser configuration. Supabase publishable keys are intentionally
# safe for client bundles; never place a secret/service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional public overrides. The checked-in ¥64 Alipay business poster and
# payee name are used by default. Do not place passwords or private keys here.
NEXT_PUBLIC_ALIPAY_PAYMENT_QR_URL=
NEXT_PUBLIC_ALIPAY_PAYEE_NAME=
